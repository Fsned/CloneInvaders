; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node2D",
"class": "PlayerProperties",
"language": "GDScript",
"path": "res://Utility/PlayerProperties.gd"
}, {
"base": "Node2D",
"class": "Weapons",
"language": "GDScript",
"path": "res://Utility/Weapon.gd"
} ]
_global_script_class_icons={
"PlayerProperties": "res://1. GFX/Spaceships/Player.png",
"Weapons": ""
}

[application]

config/name="CloneInvaders"
run/main_scene="res://4. Scenes/Menus/welcomeMenu.tscn"
config/icon="res://icon.png"

[autoload]

FileGrabber="*res://Utility/fileGrabber.gd"
Dialog="*res://Utility/dialog.gd"
Global="*res://Utility/global.gd"
GameData="*res://Utility/gameData.gd"
BackgroundMusic="*res://4. Scenes/Sound/BackgroundMusic.tscn"
Weapon="*res://Utility/Weapon.gd"

[display]

window/size/width=1080
window/size/height=2400
window/size/test_width=540
window/size/test_height=1200
window/stretch/mode="2d"
window/stretch/aspect="expand"

