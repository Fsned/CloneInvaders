; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CloneInvaders"
run/main_scene="res://4. Scenes/Menus/welcomeMenu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

FileGrabber="*res://Utility/fileGrabber.gd"
Dialog="*res://Utility/dialog.gd"
Global="*res://Utility/global.gd"
GameData="*res://Utility/gameData.gd"
BackgroundMusic="*res://4. Scenes/Sound/BackgroundMusic.tscn"
Weapon="*res://Utility/Weapon.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/window_width_override=540
window/size/window_height_override=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

